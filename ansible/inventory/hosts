# Nenhum host dedicado a Docker na infra atual (apenas o cluster K3s de 3 nós).
# Mantido como grupo vazio para o play "docker" do site.yml não falhar.
# Ver docs/homelab_day02.md, seção 3.2.
[docker]

[all:vars]
ansible_user=luffy
ansible_ssh_private_key_file=~/.ssh/homelab
ansible_become=true
ansible_become_method=sudo
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
