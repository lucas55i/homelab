# Copie este arquivo para terraform.tfvars e preencha com seus valores

# Credenciais Proxmox
proxmox_user     = "root@pam"
proxmox_password = "sua-senha-aqui"

# Configurações do Proxmox
proxmox_node  = "proxmox"
template_name = "Debian-lab00"
storage_pool  = "local-lvm"

# Configurações de Rede
gateway        = "192.168.15.1"
network_bridge = "vmbr0"

# Configurações das VMs
vm_user     = "chrono"
vm_password = "senha-vm-aqui"

# Chave SSH pública (conteúdo do arquivo ~/.ssh/id_ed25519.pub)
ssh_public_key = <<-EOT
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... seu-usuario@hostname
EOT

